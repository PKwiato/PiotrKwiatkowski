---
import booksData from '../data/storytel-books.json';

interface Book {
  id: string;
  rawTitle: string;
  title: string;
  author: string;
  narrator: string;
  cover: string | null;
  isbn: string;
  format: string;
  progress: number;
  isFinished: boolean;
  duration: string;
  rating: number | null;
  shareUrl: string | null;
  description: string;
  dateStarted: string;
  dateFinished: string;
}

const books = booksData as Book[];
const totalBooks = books.length;
const finishedCount = books.filter(b => b.isFinished).length;
const inProgressCount = totalBooks - finishedCount;
---

<section id="books" class="py-24 px-6 md:px-12 bg-surface-container-low relative overflow-hidden">
  <!-- Subtle ambient glow background -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-primary/5 -z-10 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-primary/5 -z-10 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto">
    <!-- Header row -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-8 border-b border-outline-variant/20 pb-8">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <span class="w-2 h-2 rounded-full bg-primary glow-pulse"></span>
          <span class="text-primary font-space-grotesk text-[10px] uppercase tracking-[0.3em]">Storytel API Sync</span>
          <span class="text-outline-variant text-[10px] font-space-grotesk tracking-widest">// ARCHIVE & SHELF</span>
        </div>
        <h2 class="text-4xl md:text-6xl font-newsreader italic">
          Reading<br/>Vault
        </h2>
        <p class="font-space-grotesk text-white/60 text-sm md:text-base max-w-xl mt-3">
          Curated collection of books and audiobooks from my Storytel account. Covers, ratings, and stats synced directly via the Storytel API.
        </p>
      </div>

      <!-- Controls & Filter Section -->
      <div class="flex flex-col gap-4 items-start md:items-end">
        <!-- Filter Tabs -->
        <div class="flex flex-wrap gap-2" id="books-filter-group">
          <button 
            type="button" 
            class="filter-btn active px-4 py-2 text-[10px] uppercase tracking-widest font-space-grotesk border border-primary bg-primary text-on-primary font-bold transition-all"
            data-filter="all"
          >
            All ({totalBooks})
          </button>
          <button 
            type="button" 
            class="filter-btn px-4 py-2 text-[10px] uppercase tracking-widest font-space-grotesk border border-outline-variant/30 text-white/70 hover:border-primary/50 hover:text-white transition-all"
            data-filter="finished"
          >
            Completed ({finishedCount})
          </button>
          <button 
            type="button" 
            class="filter-btn px-4 py-2 text-[10px] uppercase tracking-widest font-space-grotesk border border-outline-variant/30 text-white/70 hover:border-primary/50 hover:text-white transition-all"
            data-filter="progress"
          >
            In Progress ({inProgressCount})
          </button>
        </div>

        <!-- Carousel Navigation Controls -->
        <div class="flex items-center gap-3 mt-2">
          <span id="carousel-counter" class="font-space-grotesk text-xs text-white/50 tracking-widest mr-2">
            <span class="text-primary font-bold" id="carousel-current">1</span> / <span id="carousel-total">{totalBooks}</span>
          </span>

          <button 
            id="carousel-prev" 
            type="button" 
            aria-label="Previous book"
            class="w-10 h-10 border border-outline-variant/30 bg-surface-container flex items-center justify-center text-white hover:border-primary hover:text-primary transition-all disabled:opacity-30 disabled:pointer-events-none active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <button 
            id="carousel-next" 
            type="button" 
            aria-label="Next book"
            class="w-10 h-10 border border-outline-variant/30 bg-surface-container flex items-center justify-center text-white hover:border-primary hover:text-primary transition-all disabled:opacity-30 disabled:pointer-events-none active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Carousel Viewport -->
    <div 
      id="books-carousel-track" 
      class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory py-4 no-scrollbar cursor-grab active:cursor-grabbing"
      tabindex="0"
      aria-label="Storytel reading archive carousel"
    >
      {books.map((book, index) => (
        <article 
          class="book-card shrink-0 w-[240px] sm:w-[270px] md:w-[290px] snap-start bg-surface-container/40 border border-outline-variant/20 hover:border-primary/50 transition-all duration-300 p-4 group flex flex-col justify-between"
          data-status={book.isFinished ? "finished" : "progress"}
          data-index={index}
        >
          <!-- Cover container -->
          <div>
            <div class="relative aspect-square overflow-hidden bg-surface-container border border-white/5 mb-4 group-hover:shadow-[0_8px_30px_rgba(255,143,115,0.15)] transition-all">
              {book.cover ? (
                <img 
                  src={book.cover} 
                  alt={`Cover for ${book.title}`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center bg-surface-bright">
                  <span class="text-xs uppercase font-space-grotesk text-white/40">{book.format}</span>
                  <span class="font-newsreader italic text-sm mt-2">{book.title}</span>
                </div>
              )}

              <!-- Storytel Badge overlay -->
              <div class="absolute top-2 right-2 bg-black/80 backdrop-blur-sm border border-white/10 px-2 py-0.5 text-[8px] font-space-grotesk uppercase tracking-wider text-primary">
                Storytel
              </div>

              <!-- Format overlay -->
              <div class="absolute bottom-2 left-2 bg-black/80 backdrop-blur-sm border border-white/10 px-2 py-0.5 text-[8px] font-space-grotesk uppercase tracking-wider text-white/80">
                {book.format}
              </div>
            </div>

            <!-- Progress bar / Badge -->
            <div class="mb-3">
              <div class="flex justify-between items-center text-[10px] font-space-grotesk mb-1.5">
                <span class={book.isFinished ? "text-primary uppercase tracking-widest font-semibold" : "text-white/60 uppercase tracking-widest"}>
                  {book.isFinished ? "Completed (100%)" : `In Progress (${book.progress}%)`}
                </span>
                {book.duration && (
                  <span class="text-white/40">{book.duration}</span>
                )}
              </div>
              <div class="w-full h-1 bg-surface-bright relative overflow-hidden">
                <div 
                  class={`h-full transition-all duration-500 ${book.isFinished ? 'bg-primary' : 'bg-primary/50'}`}
                  style={`width: ${Math.max(book.progress, 5)}%`}
                ></div>
              </div>
            </div>

            <!-- Title & Author -->
            <h3 class="font-newsreader italic text-lg leading-snug line-clamp-2 text-white group-hover:text-primary transition-colors min-h-[3rem]" title={book.title}>
              {book.title}
            </h3>
            <p class="font-space-grotesk text-xs text-white/60 tracking-wider uppercase mt-1 line-clamp-1" title={book.author}>
              {book.author || "—"}
            </p>
          </div>

          <!-- Card Footer (Meta & Action) -->
          <div class="mt-4 pt-3 border-t border-outline-variant/10 flex items-center justify-between text-[11px] font-space-grotesk">
            {book.rating ? (
              <span class="flex items-center gap-1 text-primary">
                <span>★</span>
                <span>{book.rating.toFixed(1)}</span>
              </span>
            ) : (
              <span class="text-white/30 text-[10px]">—</span>
            )}

            <div class="flex items-center gap-2">
              <button 
                type="button" 
                class="open-modal-btn text-[10px] uppercase tracking-wider text-white/70 hover:text-primary transition-colors cursor-pointer"
                data-book={JSON.stringify(book)}
              >
                Overview
              </button>
              {book.shareUrl && (
                <a 
                  href={book.shareUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-outline-variant hover:text-primary transition-colors inline-flex items-center p-1"
                  title="Open on Storytel"
                >
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Carousel Progress Indicator Bar -->
    <div class="mt-6 w-full h-0.5 bg-surface-bright relative">
      <div id="carousel-scrollbar-thumb" class="h-full bg-primary transition-all duration-150" style="width: 10%;"></div>
    </div>
  </div>

  <!-- Book Detail Modal -->
  <dialog 
    id="book-modal" 
    class="backdrop:bg-black/80 backdrop:backdrop-blur-sm bg-surface-container border border-outline-variant/30 text-white p-0 max-w-2xl w-[90vw] m-auto z-50 shadow-2xl open:animate-fadeIn"
  >
    <div class="p-6 md:p-8 relative">
      <button 
        id="close-modal" 
        type="button"
        class="absolute top-4 right-4 w-8 h-8 border border-outline-variant/30 flex items-center justify-center text-white/70 hover:text-primary hover:border-primary transition-colors"
        aria-label="Close"
      >
        ✕
      </button>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        <div class="md:col-span-4 aspect-square bg-surface-bright border border-outline-variant/20 overflow-hidden relative">
          <img id="modal-cover" src="" alt="" class="w-full h-full object-cover" />
          <div class="absolute top-2 left-2 bg-black/80 text-[8px] font-space-grotesk uppercase px-2 py-0.5 text-primary">
            Storytel
          </div>
        </div>

        <div class="md:col-span-8 space-y-4">
          <div>
            <span id="modal-format" class="text-[10px] text-primary uppercase tracking-widest font-space-grotesk block mb-1"></span>
            <h3 id="modal-title" class="text-2xl md:text-3xl font-newsreader italic text-white leading-tight"></h3>
            <p id="modal-author" class="font-space-grotesk text-sm text-white/70 uppercase tracking-wider mt-1"></p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 py-3 border-y border-outline-variant/20 text-[10px] font-space-grotesk">
            <div>
              <span class="text-white/40 block">PROGRESS:</span>
              <span id="modal-progress" class="text-primary font-bold"></span>
            </div>
            <div>
              <span class="text-white/40 block">DURATION:</span>
              <span id="modal-duration" class="text-white"></span>
            </div>
            <div>
              <span class="text-white/40 block">STORYTEL RATING:</span>
              <span id="modal-rating" class="text-white"></span>
            </div>
            <div id="modal-narrator-box" class="sm:col-span-3">
              <span class="text-white/40 block">NARRATOR:</span>
              <span id="modal-narrator" class="text-white"></span>
            </div>
          </div>

          <div>
            <h4 class="text-xs uppercase tracking-widest font-space-grotesk text-white/40 mb-2">Synopsis</h4>
            <div id="modal-desc" class="font-space-grotesk text-xs md:text-sm text-white/80 leading-relaxed max-h-48 overflow-y-auto pr-2 space-y-2 whitespace-pre-line"></div>
          </div>

          <div class="pt-2 flex gap-4">
            <a 
              id="modal-link" 
              href="#" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-primary text-xs w-full text-center"
            >
              Open on Storytel
            </a>
          </div>
        </div>
      </div>
    </div>
  </dialog>
</section>

<style>
  /* Hide standard scrollbars for carousel track */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  dialog[open] {
    animation: fadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('books-carousel-track');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const counterCurrent = document.getElementById('carousel-current');
    const counterTotal = document.getElementById('carousel-total');
    const scrollbarThumb = document.getElementById('carousel-scrollbar-thumb');
    const filterButtons = document.querySelectorAll('#books-filter-group .filter-btn');
    const cards = Array.from(document.querySelectorAll('.book-card'));

    if (!track) return;

    // Carousel Scroll Next / Prev
    function scrollCarousel(direction) {
      const card = track.querySelector('.book-card:not([style*="display: none"])');
      const cardWidth = card ? card.offsetWidth + 24 : 300;
      track.scrollBy({
        left: direction * cardWidth * 1.5,
        behavior: 'smooth'
      });
    }

    prevBtn?.addEventListener('click', () => scrollCarousel(-1));
    nextBtn?.addEventListener('click', () => scrollCarousel(1));

    // Update Counter & Scrollbar Indicator
    function updateProgress() {
      const visibleCards = cards.filter(c => c.style.display !== 'none');
      if (visibleCards.length === 0) return;

      const maxScroll = track.scrollWidth - track.clientWidth;
      const progress = maxScroll > 0 ? track.scrollLeft / maxScroll : 0;

      if (scrollbarThumb) {
        const thumbWidth = Math.max(10, Math.min(100, (track.clientWidth / track.scrollWidth) * 100));
        scrollbarThumb.style.width = `${thumbWidth}%`;
        const maxOffset = 100 - thumbWidth;
        scrollbarThumb.style.transform = `translateX(${(progress * maxOffset * (100 / thumbWidth))}%)`;
      }

      // Estimate current active card
      const scrollCenter = track.scrollLeft + 100;
      let activeIndex = 0;
      for (let i = 0; i < visibleCards.length; i++) {
        if (visibleCards[i].offsetLeft <= scrollCenter) {
          activeIndex = i;
        }
      }
      if (counterCurrent) counterCurrent.textContent = (activeIndex + 1).toString();
      if (counterTotal) counterTotal.textContent = visibleCards.length.toString();
    }

    track.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();

    // Mouse drag scrolling
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    track.addEventListener('mousedown', (e) => {
      // Don't trigger drag on button clicks
      if (e.target.closest('button') || e.target.closest('a')) return;
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', () => { isDown = false; });
    track.addEventListener('mouseup', () => { isDown = false; });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      track.scrollLeft = scrollLeft - walk;
    });

    // Filtering logic
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary', 'font-bold', 'border-primary');
          b.classList.add('border-outline-variant/30', 'text-white/70');
        });
        btn.classList.add('bg-primary', 'text-on-primary', 'font-bold', 'border-primary');
        btn.classList.remove('border-outline-variant/30', 'text-white/70');

        const filter = btn.getAttribute('data-filter');

        cards.forEach(card => {
          const status = card.getAttribute('data-status');
          if (filter === 'all' || status === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        track.scrollTo({ left: 0, behavior: 'smooth' });
        updateProgress();
      });
    });

    // Modal Details Logic
    const modal = document.getElementById('book-modal');
    const closeModalBtn = document.getElementById('close-modal');
    const modalCover = document.getElementById('modal-cover');
    const modalTitle = document.getElementById('modal-title');
    const modalAuthor = document.getElementById('modal-author');
    const modalFormat = document.getElementById('modal-format');
    const modalProgress = document.getElementById('modal-progress');
    const modalDuration = document.getElementById('modal-duration');
    const modalRating = document.getElementById('modal-rating');
    const modalNarrator = document.getElementById('modal-narrator');
    const modalNarratorBox = document.getElementById('modal-narrator-box');
    const modalDesc = document.getElementById('modal-desc');
    const modalLink = document.getElementById('modal-link');

    document.querySelectorAll('.open-modal-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const bookData = JSON.parse(btn.getAttribute('data-book') || '{}');

        if (modalCover) modalCover.src = bookData.cover || '';
        if (modalTitle) modalTitle.textContent = bookData.title || '';
        if (modalAuthor) modalAuthor.textContent = bookData.author || '';
        if (modalFormat) modalFormat.textContent = bookData.format || 'AUDIOBOOK';
        if (modalProgress) modalProgress.textContent = bookData.isFinished ? '100% (Completed)' : `${bookData.progress}%`;
        if (modalDuration) modalDuration.textContent = bookData.duration || '—';
        if (modalRating) modalRating.textContent = bookData.rating ? `★ ${bookData.rating.toFixed(2)}` : '—';
        
        if (modalNarrator && modalNarratorBox) {
          if (bookData.narrator) {
            modalNarrator.textContent = bookData.narrator;
            modalNarratorBox.style.display = 'block';
          } else {
            modalNarratorBox.style.display = 'none';
          }
        }

        if (modalDesc) {
          modalDesc.textContent = bookData.description || 'No synopsis available in the Storytel catalog.';
        }

        if (modalLink) {
          if (bookData.shareUrl) {
            modalLink.href = bookData.shareUrl;
            modalLink.style.display = 'inline-flex';
          } else {
            modalLink.style.display = 'none';
          }
        }

        if (modal && typeof modal.showModal === 'function') {
          modal.showModal();
        }
      });
    });

    closeModalBtn?.addEventListener('click', () => {
      if (modal && typeof modal.close === 'function') modal.close();
    });

    modal?.addEventListener('click', (e) => {
      const rect = modal.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        modal.close();
      }
    });
  });
</script>
